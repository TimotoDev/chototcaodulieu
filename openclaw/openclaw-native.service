[Unit]
Description=OpenClaw Service
After=network.target antigravity-proxy.service
Wants=antigravity-proxy.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/openclaw
ExecStart=/usr/local/bin/pnpm start --allow-unconfigured
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=OPENCLAW_CONFIG_PATH=/etc/openclaw/config.json

[Install]
WantedBy=multi-user.target
